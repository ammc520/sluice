LISTEN_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080
DATABASE_URL=postgres://gateway:gateway@localhost:5432/gateway?sslmode=disable
AUDIT_MAINTENANCE_DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
# base64 encoded 32-byte key: openssl rand -base64 32
MASTER_KEY=
MASTER_KEY_PREVIOUS=
COOKIE_SECURE=true
TRUSTED_PROXIES=
REQUEST_BODY_LIMIT_BYTES=2097152
CAPTURE_LIMIT_BYTES=262144
AUDIT_RETENTION_DAYS=180
AUDIT_SPOOL_DIR=./spool
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
DEFAULT_RESERVE_TOKENS=4096
