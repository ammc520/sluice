# Production settings for docker-compose.yml.
# Copy to .env.production, fill every CHANGE_ME, then:
#   chmod 600 .env.production
#
# Generate the master key (exactly 32 bytes, base64):
#   openssl rand -base64 32
# Generate the database and admin passwords with a password manager or:
#   openssl rand -hex 24

# --- Caddy / public address -------------------------------------------------
# DNS A/AAAA record must point at this server before starting Caddy.
DOMAIN=api.example.com
PUBLIC_BASE_URL=https://api.example.com

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=gateway
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=gateway

# The gateway connects over the private Compose network. For the first boot
# this may be the POSTGRES_USER superuser; after creating gateway_app (see
# docs/operations/deploy.md) switch this URL to the application role.
# URL-encode special characters in the password.
DATABASE_URL=postgres://gateway:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/gateway?sslmode=disable

# --- Gateway secrets --------------------------------------------------------
MASTER_KEY=CHANGE_ME_BASE64_32_BYTE_KEY
# Set only while rotating MASTER_KEY; remove after all data is re-encrypted.
MASTER_KEY_PREVIOUS=

# --- Bootstrap administrator ------------------------------------------------
# Used only when no administrator exists. After first login, change the
# password in the UI and remove BOOTSTRAP_ADMIN_PASSWORD from this file.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# --- Gateway behaviour ------------------------------------------------------
COOKIE_SECURE=true
# Docker bridge networks. Narrow this if your Compose network uses another
# range; never trust arbitrary internet proxies.
TRUSTED_PROXIES=172.16.0.0/12
REQUEST_BODY_LIMIT_BYTES=2097152
CAPTURE_LIMIT_BYTES=262144
AUDIT_RETENTION_DAYS=180
DEFAULT_RESERVE_TOKENS=4096
ADMIN_SESSION_TTL_HOURS=12
# Employee portal session lifetime. The portal is disabled until an
# administrator enables it in 系统设置 → 员工门户.
PORTAL_SESSION_TTL_HOURS=8
# Only enable for a deliberately self-hosted model on a private address.
ALLOW_PRIVATE_UPSTREAMS=false

# --- Audit retention --------------------------------------------------------
# A dedicated role with SELECT(event_time) and DELETE on audit_logs only.
# Leave empty to disable automatic retention until the role exists
# (see docs/operations/deploy.md).
AUDIT_MAINTENANCE_DATABASE_URL=
